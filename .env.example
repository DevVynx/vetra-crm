# Application
NODE_ENV="development"

# API
API_PORT="8000"
FRONTEND_URL="http://localhost:3000"
DATABASE_URL="postgresql://dev:dev@localhost:5432/vetra"
STORAGE_DIR="storage"

# WhatsApp (WAHA): replace the key with a long random value
WAHA_URL="http://127.0.0.1:3001"
WAHA_API_KEY="change-me"

# Web
WEB_PORT="3000"
VITE_API_URL="http://127.0.0.1:8000/api"

# Development only (compose.dev.yaml): the host ports of the database and WhatsApp. If you change one, change DATABASE_URL or WAHA_URL above to match
VETRA_DB_PORT="5432"
VETRA_WAHA_PORT="3001"
