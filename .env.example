# Application
NODE_ENV="development"

# --- API ---
API_PORT="8000"
FRONTEND_URL="http://localhost:3000"

# PostgreSQL (see compose.yaml)
DATABASE_URL="postgresql://dev:dev@localhost:5432/vetra"

# Where the API keeps the files it owns, such as the profile photo. Optional; a relative path
# is read from where the API runs.
# STORAGE_DIR="storage"

# WAHA, the WhatsApp service (see compose.yaml). Replace the key with a long random value.
WAHA_URL="http://127.0.0.1:3001"
WAHA_API_KEY="change-me"

# --- WEB ---
WEB_PORT="3000"
VITE_API_URL="http://127.0.0.1:8000/api"
