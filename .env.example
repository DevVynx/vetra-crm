# Application
NODE_ENV="development"

# --- API ---
API_PORT="8000"
FRONTEND_URL="http://localhost:3000"

# PostgreSQL (see compose.yaml)
DATABASE_URL="postgresql://dev:dev@localhost:5432/vetra"

# Where the API keeps the files it owns, such as the profile photo. Optional; a relative path
# is read from where the API runs.
# STORAGE_DIR="storage"

# WAHA, the WhatsApp service (see compose.yaml). Replace the key with a long random value.
WAHA_URL="http://127.0.0.1:3001"
WAHA_API_KEY="change-me"

# Development only: the host ports of the database and WhatsApp (compose.override.yaml). If you change
# one, change DATABASE_URL / WAHA_URL above to match.
# VETRA_DB_PORT="5432"
# VETRA_WAHA_PORT="3001"

# The port Vetra answers on when it runs from Docker (iniciar-vetra). Unusual on purpose, so it does
# not clash with other programs. The address is http://localhost:4720.
# VETRA_PORT="4720"

# --- WEB ---
WEB_PORT="3000"
VITE_API_URL="http://127.0.0.1:8000/api"
