# Vetra: the settings of this installation.
# The launcher fills WAHA_API_KEY by itself the first time, so there is nothing to edit here.
WAHA_API_KEY="change-me"

# The version of Vetra this installation runs. The update script (atualizar-vetra) changes it by itself.
# Without it, the latest version is used.
# VETRA_VERSION="0.1.0"
