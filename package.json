{
  "name": "vetra-crm",
  "private": true,
  "license": "PolyForm-Shield-1.0.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "docker:dev": "docker compose -f compose.dev.yaml up -d --wait",
    "docker:dev:down": "docker compose -f compose.dev.yaml down",
    "demo:up": "node demo/demo.mjs up",
    "demo:down": "node demo/demo.mjs down",
    "check-types": "turbo run check-types",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "format": "turbo run lint:fix && prettier --write .",
    "db:seed": "pnpm --filter @vetra/database db:seed"
  },
  "devDependencies": {
    "@vetra/prettier-config": "workspace:*",
    "eslint": "10.9.1",
    "prettier": "3.9.6",
    "prettier-plugin-tailwindcss": "0.8.1",
    "turbo": "^2.10.12"
  },
  "engines": {
    "node": ">=24.20.0"
  },
  "packageManager": "pnpm@11.24.0"
}
