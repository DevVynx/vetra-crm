{
  "name": "api",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm env:load tsx watch src/server.ts",
    "build": "tsup",
    "check-types": "tsc --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint \"src/**/*.{ts,tsx}\" --fix",
    "env:load": "dotenv -e ../../.env --"
  },
  "dependencies": {
    "@vetra/contracts": "workspace:*",
    "@vetra/core": "workspace:*",
    "@vetra/env": "workspace:*",
    "@vetra/routes": "workspace:*",
    "cors": "2.8.6",
    "express": "5.2.1",
    "helmet": "8.3.0",
    "zod": "^4.6.1"
  },
  "devDependencies": {
    "@vetra/eslint-config": "workspace:*",
    "@vetra/tsconfig": "workspace:*",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "22.20.2",
    "dotenv-cli": "11.0.0",
    "tsup": "^8.0.0",
    "tsx": "^4.7.2",
    "typescript": "^7.0.2"
  }
}
